{
	"id": "notariat-grundstueckskauf",
	"name": "Notary: Property Purchase",
	"description": "Run notarial property purchases from intake to transfer of ownership: an agent reads client and broker data, lists missing details, fills the contract template and watches every completion deadline.",
	"category": "Legal",
	"schema_version": 1,
	"tags": [
		"Notariat",
		"Kanzlei",
		"Grundstückskauf",
		"AI-ready"
	],
	"features": [
		"Vorgangs-Board von Eingang bis Eigentumsumschreibung",
		"Beteiligte mit Identitäts-, GwG-, Transparenzregister- und Sanktionslisten-Status",
		"Grundstücke mit Grundbuchstelle, Eigentümer und Belastungen",
		"Fristen- und Vollzugsüberwachung mit Kalender und Überfällig-Ansicht",
		"Online-Formular für Mandanten und Makler als Eingang",
		"Vorlagen für Grundmuster und Musterschreiben"
	],
	"outcomes": [
		"Eine Makler-E-Mail einfügen — der Agent legt Akte, Beteiligte und Objekt an",
		"Fehlende Angaben stehen als Liste mit fertigem Rückfragetext im Vorgang",
		"Den Vertragsentwurf aus dem eigenen Grundmuster vorbereiten lassen",
		"Jeden Morgen sehen, welche Genehmigung, Löschungsbewilligung oder Frist offen ist"
	],
